# Database. Defaults to local SQLite file. Point this at a Postgres URL
# (e.g. postgresql+psycopg://user:pass@host:5432/animal_arena) to switch
# databases with no code changes -- the schema avoids SQLite-only features.
DATABASE_URL=sqlite:///./animal_arena.db

# Anthropic API key for the AI commentary layer. Required only for the
# /api/commentary endpoint -- the simulation engine itself needs no LLM
# and works with this unset. NEVER expose this key to the frontend.
ANTHROPIC_API_KEY=

# Model used for commentary generation.
ANTHROPIC_MODEL=claude-sonnet-4-5

# Comma-separated list of origins allowed to call this API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Logging verbosity: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
